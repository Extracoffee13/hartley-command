<!-- Live-data hydration · reads hermes-status.json (written hourly by hermes-status-writer Call).
     Failed fetch leaves static fallback values in place — dashboard stays usable offline. -->
<script>
(function hydrateLive() {
  function update(key, val) {
    document.querySelectorAll('[data-live="' + key + '"]').forEach(el => {
      if (val !== null && val !== undefined && val !== '') el.textContent = String(val);
    });
  }
  const sources = [
    './hermes-status.json',
    'https://extracoffee13.github.io/hartley-command/hermes-status.json'
  ];
  // Harvard Corpus hydration — separate JSON
  (async () => {
    try {
      const r = await fetch('./harvard-corpus-stats.json?nocache=' + Date.now(), { cache: 'no-store' });
      if (!r.ok) {
        const r2 = await fetch('https://extracoffee13.github.io/hartley-command/harvard-corpus-stats.json?nocache=' + Date.now(), { cache: 'no-store' });
        if (!r2.ok) return;
        const hc = await r2.json();
        update('hc_total', hc.total_articles);
        update('hc_faculty', hc.faculty_indexed);
        update('hc_topics', hc.topics_covered);
        update('hc_faclinks', (hc.total_faculty_links || 0).toLocaleString());
        update('hc_topiclinks', (hc.total_topic_links || 0).toLocaleString());
        update('hc_hbswk', hc.by_source && hc.by_source.hbswk);
        return;
      }
      const hc = await r.json();
      update('hc_total', hc.total_articles);
      update('hc_faculty', hc.faculty_indexed);
      update('hc_topics', hc.topics_covered);
      update('hc_faclinks', (hc.total_faculty_links || 0).toLocaleString());
      update('hc_topiclinks', (hc.total_topic_links || 0).toLocaleString());
      update('hc_hbswk', hc.by_source && hc.by_source.hbswk);
    } catch (e) { /* fallback to static */ }
  })();

  // Flock classification hydration — flock-classification.json (added 2026-06-05 PM)
  // Replaces hardcoded "13 wild ducks · 33 calls" with live count from classifier output.
  (async () => {
    const urls = [
      './flock-classification.json?cb=' + Date.now(),
      'https://extracoffee13.github.io/hartley-command/flock-classification.json?cb=' + Date.now(),
    ];
    let fc = null;
    for (const u of urls) {
      try { const r = await fetch(u, {cache:'no-store'}); if (r.ok) { fc = await r.json(); break; } } catch(_){}
    }
    if (!fc) return;
    const wd = (fc.wild_ducks && fc.wild_ducks.count) || 0;
    const ca = (fc.calls && fc.calls.count) || 0;
    update('hermes-flock-summary', `hermes-agent v0.15 · substrate · ${wd} wild ducks · ${ca} calls`);
    update('wild_ducks_count', wd);
    update('calls_count', ca);
  })();

  // Skills Registry hydration — daily-scanner output (added 2026-06-05)
  // Reads installed-skills-registry.json + compares to hardcoded INTERNAL_AGENTS cards
  (async () => {
    const urls = [
      './installed-skills-registry.json?cb=' + Date.now(),
      'https://extracoffee13.github.io/hartley-command/installed-skills-registry.json?cb=' + Date.now(),
    ];
    let reg = null;
    for (const u of urls) {
      try { const r = await fetch(u, {cache: 'no-store'}); if (r.ok) { reg = await r.json(); break; } } catch(_) {}
    }
    if (!reg) {
      update('skills_registry_total', 'registry not yet mirrored');
      update('skills_registry_ts', 'pending first sync');
      update('skills_registry_new_count', '?');
      update('skills_registry_new_list', '(brand-insights-mirror Call needs to fire once to publish the registry)');
      return;
    }
    const skills = reg.skills || [];
    update('skills_registry_total', skills.length);
    update('skills_registry_ts', (reg.updated_at || reg._mirrored_at || '?').slice(0,19) + 'Z');
    // Find skills in registry NOT in INTERNAL_AGENTS hardcoded ids
    let hardcoded = new Set();
    try {
      document.querySelectorAll('[data-internal-id]').forEach(el => hardcoded.add(el.getAttribute('data-internal-id')));
    } catch(_) {}
    // Fallback if no data-internal-id — derive from INTERNAL_AGENTS global if exposed
    const hardcodedNames = new Set([
      'graphify','taste-skill','notfair','pro-workflow','memsearch','design-extract',
      'claude-codex-settings','claude-mem','harness','awesome-claude-plugins',
      'antigravity-skills','claude-octopus','nesquena-hermes-webui','allin','anthropic',
      'gv','jobs','hormozi','musk','nvidia','oleary','leo','harvard-library',
      'harvard-quotables','hbs-ai-institute','hbs-courses','frontier-firm-framework',
    ]);
    const newOnes = skills.filter(s => {
      const nm = (s.name || s.slug || s.id || '').toLowerCase();
      return nm && !hardcodedNames.has(nm);
    });
    update('skills_registry_new_count', newOnes.length);
    update('skills_registry_new_list',
      newOnes.length === 0 ? 'all registry skills represented in Internal cards · no new discoveries today' :
      newOnes.map(s => '· ' + (s.name || s.slug || s.id || '?')).join('  '));
  })();

  (async () => {
    for (const url of sources) {
      try {
        const res = await fetch(url + '?nocache=' + Date.now(), { cache: 'no-store' });
        if (!res.ok) continue;
        const d = await res.json();
        // Flock counts are authoritative from flock-classification.json — skip them here
        const skipKeys = new Set(['wild_ducks_count', 'calls_count']);
        Object.entries(d).forEach(([k, v]) => { if (!skipKeys.has(k)) update(k, v); });
        // Stamp the source URL so we can see it worked
        const stamp = document.createElement('div');
        stamp.style.cssText = 'position:fixed;bottom:6px;right:8px;font-size:8px;color:#39ff14;opacity:0.4;font-family:monospace;letter-spacing:1px';
        stamp.textContent = 'live · ' + new Date(d.heartbeat_ts || d.last_write || Date.now()).toLocaleTimeString();
        document.body.appendChild(stamp);
        return;
      } catch (e) { /* try next source */ }
    }
  })();
  // Re-hydrate after React mounts (give it 600ms)
  setTimeout(hydrateLive, 600);
})();
</script>

